---
interface Props { name?: 'arrow' | 'check' | 'play' | 'chevron'; }
const { name = 'arrow' } = Astro.props;
const paths = { arrow: 'M4 12h16m-6-6 6 6-6 6', check: 'm5 12 4 4L19 6', play: 'm9 5 10 7-10 7V5Z', chevron: 'm9 5 7 7-7 7' };
---
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
